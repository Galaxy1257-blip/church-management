# --- database / cache -------------------------------------------------------
# Runtime connects as app_user (RLS enforced). Migrations/extras/roles run as
# the owner. Worker/webhook platform lookups use platform_user (BYPASSRLS).
OWNER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chms
DATABASE_URL=postgresql://app_user:app_dev_password@localhost:5432/chms
PLATFORM_DATABASE_URL=postgresql://platform_user:platform_dev_password@localhost:5432/chms
REDIS_URL=redis://localhost:6379
APP_USER_PASSWORD=app_dev_password
PLATFORM_USER_PASSWORD=platform_dev_password

# --- api ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
# Comma-separated CORS allowlist. Only these origins may call the API from a
# browser; '*' disables the check (do not use it in production). Behind a proxy
# (Render/Cloudflare) the API trusts one hop so rate limits key on the real IP.
WEB_URL=http://localhost:3000
# In production (NODE_ENV=production) the API REFUSES TO BOOT with the dev defaults
# below and requires >= 32 chars for JWT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-32chars-min-secret!!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Required header value for POST /churches (platform onboarding) in non-prod.
PLATFORM_SIGNUP_KEY=dev-platform-signup-key

# --- paystack ----------------------------------------------------------------
# mock: no keys needed, ideal for local dev + tests. live: use sandbox keys.
PAYSTACK_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- sms gateway -------------------------------------------------------------
# mock: logs to console + records rows (local dev).
# csms: cSMS V3 (app.mycsms.com). VERIFIED from the provided docx: base URL,
# POST /v3/sms/send, Bearer auth. NOT yet verified: JSON body field names —
# review the Postman doc (https://documenter.getpostman.com/view/7212992/2sBXVbGDA2),
# adjust apps/worker/src/sms-gateway.ts if the field names differ, then set
# CSMS_VERIFIED=true. Never commit a real token.
SMS_GATEWAY=mock
SMS_WEBHOOK_SECRET=dev-sms-webhook-secret
CSMS_BASE_URL=https://app.mycsms.com/api
CSMS_API_TOKEN=
CSMS_SENDER_ID=
CSMS_VERIFIED=false
